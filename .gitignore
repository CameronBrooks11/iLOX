# CI/local build inputs for the docs model embeds (see .github/workflows/pages.yml)
# tessella is the external OpenSCAD library dependency, cloned beside iLOX.scad
# so `include <tessella/tess.scad>` resolves; rendered/ holds the render step's
# OFF geometry and PNG posters; publish-staging/ is the staged customizer tree.
tessella/
rendered/
publish-staging/

# Local working files, such as working.tmp/
*.tmp

# Exports from openscad -o or scadbatch; none are committed
*.stl
*.off
*.3mf
*.csg
