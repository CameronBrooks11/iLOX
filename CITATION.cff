    family-names: Brooks
version: 0.1.0
date-released: "2026-11-01"
license: MPL-2.0
repository-code: "https://github.com/CameronBrooks11/iLOX"
url: "https://cameronbrooks11.github.io/iLOX/"
keywords:
  - openscad
  - 3d-printing
  - parametric-design
  - tessellation
  - interlocking
